% ==========================================
% 9. Box 系統引擎 
% ==========================================
\RequirePackage[most]{tcolorbox}
\RequirePackage{xparse}

\let\proof\relax
\let\endproof\relax

% --- 樣式設定 ---
\tcbset{
  fancybox/.style={
    enhanced, breakable,
    arc=8pt, outer arc=8pt, boxrule=0.8pt, boxsep=8pt,
    drop shadow, % <--- 修復: 移除錯誤的 shadow xshift 參數，使用原生安全陰影
    attach boxed title to top center={yshift=-2mm},
    boxed title style={arc=6pt, outer arc=6pt},
    borderline={0.7mm}{0mm}{#1!50!white},
    borderline={0.7mm}{1mm}{#1!30!white},
    borderline={0.7mm}{2mm}{#1!15!white},
    fonttitle=\bfseries\color{#1!80!black},
  }
}

% --- 生成器 A: Fancy Box (帶數字/不帶數字版本) ---
\NewDocumentCommand{\NewJesseFancyBox}{m m m}{
  \DeclareTColorBox[auto counter, number within=subsection]{#1}{ o }{
    fancybox=#2, colback=#2!5!white, colframe=#2,
    boxed title style={colback=#2!40!white},
    title={#3 \thetcbcounter\IfValueTF{##1}{\enskip(##1)}{}}
  }
  \DeclareTColorBox{#1*}{ o }{
    fancybox=#2, colback=#2!5!white, colframe=#2,
    boxed title style={colback=#2!40!white},
    title={#3\IfValueTF{##1}{\enskip(##1)}{}}
  }
}

% --- 生成器 B: 側邊線 Box (特別優化標題間距與邊界) ---
\NewDocumentCommand{\NewJesseSideBox}{m m m}{
  \DeclareTColorBox[auto counter, number within=subsection]{#1}{ o }{
    enhanced, breakable,
    colback=#2!10!white, 
    colframe=#2!10!white, 
    coltitle=#2,          
    colbacktitle=#2!10!white, 
    fonttitle=\bfseries,
    boxrule=0pt, titlerule=0pt, 
    arc=6pt,
    borderline west={3.5pt}{0pt}{#2}, % 左側邊條稍微加粗至 3.5pt，視覺更穩定
    before skip=10pt, after skip=10pt,
    % === 間距微調重點 ===
    toptitle=8pt,     % 標題距離頂部邊界增至 8pt (解決太靠上的問題)
    bottomtitle=3pt,  % 標題與下方正文的距離
    top=0pt,          % 正文上方額外間距
    bottom=8pt,       % 底部內邊距 (與頂部對稱)
    left=10pt,        % 左側文字留白
    right=10pt,       % 右側文字留白
    title={#3 \thetcbcounter\IfValueTF{##1}{\enskip(##1)}{}}
  }
  \DeclareTColorBox{#1*}{ o }{
    enhanced, breakable,
    colback=#2!10!white, 
    colframe=#2!10!white, 
    coltitle=#2,          
    colbacktitle=#2!10!white, 
    fonttitle=\bfseries,
    boxrule=0pt, titlerule=0pt, 
    arc=6pt,
    borderline west={3.5pt}{0pt}{#2}, 
    before skip=10pt, after skip=10pt,
    % === 間距微調重點 ===
    toptitle=8pt,
    bottomtitle=3pt,
    top=0pt,
    bottom=8pt,
    left=10pt,
    right=10pt,
    title={#3\IfValueTF{##1}{\enskip(##1)}{}}
  }
}


% --- 批量註冊 Box ---
\NewJesseFancyBox{theorem}{UltramarineSoft}{Theorem}

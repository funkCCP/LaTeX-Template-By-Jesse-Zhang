% --- 特殊 Box: Sample ---
\DeclareTColorBox{sample}{ m }{
  enhanced, breakable, colback=SoftBlue, colframe=AccentTeal!70!black,
  boxrule=0.8pt, arc=5mm, left=2mm, right=2mm, top=1.5mm, bottom=1.5mm,
  title=\bfseries #1, fonttitle=\bfseries\color{white}
}

% --- \paragraph 樣式設定 (深藍色段落符號 - 強制顯示版) ---
\titleformat{\paragraph}[hang]
  {\normalfont\bfseries\color{blue}}    % 設定標題文字為粗體
  {}                              % [關鍵修改] 這裡留空，因為預設 paragraph 沒有編號
  {0pt}                           % 標籤與標題的距離設為 0
  {\textcolor{blue}{\P}\hspace{0.5em}} % [關鍵修改] 將符號移到這裡強制顯示，並加上間距！

\titlespacing*{\paragraph}
  {0pt}                           
  {2ex plus 1ex minus .2ex}       
  {1ex plus .2ex}                 

% --- 10. 自訂表格環境修復 ---
